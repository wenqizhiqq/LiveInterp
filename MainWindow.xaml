<Window x:Class="LiveInterp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LiveInterp.ViewModels"
        Title="同声传译 · Live Interpreter"
        Width="1200" Height="720" MinWidth="1040" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Page}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="#0B1626" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#0D9488">
                        <TextBlock Text="译" Foreground="#FFFFFF" FontSize="19" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="同声传译" Foreground="#FFFFFF" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="连续收音 · 边译边播 · 人声即打断" Foreground="#7C93B0" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#12233A" CornerRadius="15" Padding="14,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding StateColor}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StateText}" Foreground="#DCE7F5" FontSize="12" Margin="8,0,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Content="静音朗读" IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                  Style="{StaticResource MuteToggle}" VerticalAlignment="Center" Margin="0,0,14,0"
                                  ToolTip="只显示字幕，不朗读。" />
                    <Button Content="▶  开始同传" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"
                            Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                    <Button Content="■  停止" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主区域 -->
        <Grid Grid.Row="1" Margin="16,16,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="560" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- 字幕流 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="20,16,20,12">
                        <Border DockPanel.Dock="Right" Background="#E6F7F4" CornerRadius="9" Padding="9,4" VerticalAlignment="Top">
                            <TextBlock Text="人声打断已启用" Foreground="#0F766E" FontSize="10.5" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="实时字幕" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="{Binding SubtitleMeta}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="SubtitleList" ItemsSource="{Binding Segments}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="Transparent" BorderBrush="#EEF2F8" BorderThickness="0,0,0,1" Padding="20,12">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DirectionText}" FontSize="10.5" Foreground="{StaticResource Muted}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                                            <Border Background="{Binding StateBack}" CornerRadius="8" Padding="7,2" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding StateText}" Foreground="{Binding StateForeground}" FontSize="10" />
                                            </Border>
                                            <Border Background="#EEF2FF" CornerRadius="8" Padding="7,2" Margin="8,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SpeakerName}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding SpeakerName}" Foreground="#4F46E5" FontSize="10" />
                                            </Border>
                                            <TextBlock Text="{Binding EngineNote}" FontSize="10.5" Foreground="{StaticResource Muted}"
                                                       Margin="9,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TimingText}" DockPanel.Dock="Right" FontSize="10.5"
                                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Source}" FontSize="13" Foreground="{StaticResource Sub}"
                                                   TextWrapping="Wrap" Margin="0,7,0,4" />
                                        <TextBlock Text="{Binding Translation}" FontSize="19" FontWeight="SemiBold"
                                                   Foreground="{Binding TranslationBrush}" TextWrapping="Wrap" LineHeight="29"
                                                   ToolTip="{Binding MatchedSource}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470" Margin="24">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Segments.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="正在监听，请直接说话" FontSize="20" FontWeight="SemiBold"
                                       Foreground="#334155" HorizontalAlignment="Center"
                                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="按下右上角的「开始同传」" FontSize="20" FontWeight="SemiBold"
                                       Foreground="#334155" HorizontalAlignment="Center"
                                       Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}" />
                            <TextBlock Text="允许麦克风后直接说话。程序会逐句识别、翻译并朗读；对方一开口，朗读立刻停止。"
                                       Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,8,0,0"
                                       Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}" />
                            <TextBlock Text="说完一句停顿一下，译文会在停顿处朗读；再次开口立即打断。"
                                       Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,8,0,0"
                                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                            <Border Background="#F8FAFC" BorderBrush="#E6EBF3" BorderThickness="1" CornerRadius="10"
                                    Padding="14,12" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="可以试着读这句" Style="{StaticResource Caption}" />
                                    <TextBlock Text="大家好，欢迎参加今天的会议。" FontSize="15" Foreground="{StaticResource Ink}"
                                               FontWeight="SemiBold" Margin="0,5,0,0" />
                                    <TextBlock Text="Hello everyone, welcome to today's meeting." FontSize="13.5"
                                               Foreground="#475569" Margin="0,5,0,0" />
                                    <TextBlock Text="中→英读中文；英→中读英文。" Style="{StaticResource Caption}" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="离线模式：Vosk 中/英识别 + 双向 OPUS-MT + 知识库，全程不联网。" Style="{StaticResource Caption}"
                                       TextAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Background="#FAFBFD" BorderBrush="#EEF2F8" BorderThickness="0,1,0,0" Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                    <TextBlock Text="对方声音" FontSize="10.5" Foreground="{StaticResource Sub}" />
                                    <TextBlock Text="{Binding MicDbText}" DockPanel.Dock="Right" FontSize="10.5" Foreground="{StaticResource Muted}" />
                                </DockPanel>
                                <ProgressBar Style="{StaticResource LevelBar}" Value="{Binding MicLevel, Mode=OneWay}" Foreground="#0D9488" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                    <TextBlock Text="译文朗读" FontSize="10.5" Foreground="{StaticResource Sub}" />
                                    <TextBlock Text="{Binding PlaybackDbText}" DockPanel.Dock="Right" FontSize="10.5" Foreground="{StaticResource Muted}" />
                                </DockPanel>
                                <ProgressBar Style="{StaticResource LevelBar}" Value="{Binding PlaybackLevel, Mode=OneWay}" Foreground="#7C3AED" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 设置栏 -->
            <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="打断行为" Style="{StaticResource Section}" />
                            <TextBlock Text="对方一开口，立即停播当前译文，优先处理新语音。"
                                       Style="{StaticResource Caption}" Margin="0,0,0,2" />
                            <StackPanel IsEnabled="{Binding IsIdle}">
                                <TextBlock Text="拾音方式" Style="{StaticResource FieldLabel}" />
                                <ComboBox SelectedIndex="{Binding AudioRouteIndex, Mode=TwoWay}" Style="{StaticResource FieldCombo}">
                                    <ComboBoxItem Content="耳机模式 · 低延迟（推荐）" />
                                    <ComboBoxItem Content="外放模式 · 自适应回声门控" />
                                </ComboBox>
                                <TextBlock Text="打断灵敏度" Style="{StaticResource FieldLabel}" />
                                <ComboBox SelectedIndex="{Binding SensitivityIndex, Mode=TwoWay}" Style="{StaticResource FieldCombo}">
                                    <ComboBoxItem Content="低 · 不易误触发" />
                                    <ComboBoxItem Content="中 · 默认" />
                                    <ComboBoxItem Content="高 · 轻声也会打断" />
                                </ComboBox>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="持续人声判定窗口" FontSize="11.5" Foreground="{StaticResource Sub}" />
                                    <TextBlock Grid.Column="1" Text="{Binding HoldMs, StringFormat={}{0:0} ms}"
                                               FontSize="11.5" Foreground="{StaticResource Ink}" />
                                </Grid>
                                <Slider Minimum="80" Maximum="400" TickFrequency="20" IsSnapToTickEnabled="True"
                                        Value="{Binding HoldMs, Mode=TwoWay}" Margin="0,2,0,0" />
                                <CheckBox Content="对方说话时先不抢话（等停顿再朗读）" IsChecked="{Binding PauseWhileSpeaking, Mode=TwoWay}"
                                          FontSize="11.5" Foreground="#334155" Margin="0,10,0,0" />
                                <CheckBox Content="被打断后丢弃未读译文" IsChecked="{Binding DropPending, Mode=TwoWay}"
                                          FontSize="11.5" Foreground="#334155" Margin="0,8,0,0" />
                            </StackPanel>
                            <Border Background="#F8FAFC" CornerRadius="8" Padding="10,8" Margin="0,12,0,0">
                                <TextBlock Text="{Binding EchoText}" Style="{StaticResource Caption}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="翻译引擎" Style="{StaticResource Section}" />
                            <StackPanel IsEnabled="{Binding IsIdle}">
                                <ComboBox SelectedIndex="{Binding EngineIndex, Mode=TwoWay}" Style="{StaticResource FieldCombo}">
                                    <ComboBoxItem Content="离线（NMT + 知识库）" />
                                    <ComboBoxItem Content="在线（OpenAI 兼容）" />
                                </ComboBox>
                                <TextBlock Text="语言方向" Style="{StaticResource FieldLabel}" />
                                <ComboBox SelectedIndex="{Binding DirectionIndex, Mode=TwoWay}" Style="{StaticResource FieldCombo}"
                                          IsEnabled="{Binding DirectionManualEnabled}">
                                    <ComboBoxItem Content="中文 → English" />
                                    <ComboBoxItem Content="English → 中文" />
                                </ComboBox>
                                <CheckBox Content="自动识别中/英（逐句切换方向）" IsChecked="{Binding AutoLanguage, Mode=TwoWay}"
                                          IsEnabled="{Binding IsOffline}" FontSize="11.5" Foreground="#334155" Margin="0,10,0,0" />
                                <CheckBox Content="声纹区分说话人（自动聚类，不登记姓名）" IsChecked="{Binding Diarization, Mode=TwoWay}"
                                          IsEnabled="{Binding IsOffline}" FontSize="11.5" Foreground="#334155" Margin="0,8,0,0" />
                                <TextBlock Text="自动模式逐句判断中/英；声纹按相似度聚类为「说话人 1/2…」。"
                                           Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                <StackPanel IsEnabled="{Binding IsOnline}" Margin="0,2,0,0">
                                    <TextBlock Text="接口地址" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding ApiBase, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                                    <TextBlock Text="API Key（官方接口必填）" Style="{StaticResource FieldLabel}" />
                                    <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged"
                                                 Style="{StaticResource PasswordField}" />
                                    <TextBlock Text="识别模型" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding AsrModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                                    <TextBlock Text="翻译模型" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding ChatModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                                    <TextBlock Text="识别与翻译走同一个兼容接口；本地服务可留空 API Key。"
                                               Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding EngineHint}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                            <Border Background="#F8FAFC" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding OfflineInfo}" Style="{StaticResource Caption}" Foreground="#334155" />
                                    <TextBlock Text="{Binding OfflineSources}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="声音与设备" Style="{StaticResource Section}" />
                            <TextBlock Text="设备与音色在下一次开始时生效；音量、静音可即时调整。"
                                       Style="{StaticResource Caption}" />
                            <StackPanel IsEnabled="{Binding IsIdle}">
                                <CheckBox Content="模拟输入（内置语音演示，不用麦克风、不发声）"
                                          IsChecked="{Binding SimulationMode, Mode=TwoWay}"
                                          FontSize="11.5" Foreground="#334155" Margin="0,2,0,4" />
                                <TextBlock Text="开启后自动模拟两句话：第一句完整翻译并朗读（音量 0），第二句在朗读时注入以验证打断。自动识别开启时第一句中文、第二句英文，可同时验证语种切换和声纹分人。"
                                           Style="{StaticResource Caption}" Margin="0,0,0,8" />
                                <TextBlock Text="麦克风" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding MicDevices}" SelectedItem="{Binding SelectedMic, Mode=TwoWay}"
                                          DisplayMemberPath="Name" Style="{StaticResource FieldCombo}" />
                                <TextBlock Text="播放设备" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput, Mode=TwoWay}"
                                          DisplayMemberPath="Name" Style="{StaticResource FieldCombo}" />
                                <TextBlock Text="朗读声音" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice, Mode=TwoWay}"
                                          DisplayMemberPath="Label" Style="{StaticResource FieldCombo}" />
                                <TextBlock Text="{Binding VoiceHint}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="语速" FontSize="11.5" Foreground="{StaticResource Sub}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SapiRate, StringFormat={}{0:+0;-0;0}}"
                                               FontSize="11.5" Foreground="{StaticResource Ink}" />
                                </Grid>
                                <Slider Minimum="-5" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding SapiRate, Mode=TwoWay}" Margin="0,2,0,0" />
                                <Button Content="刷新设备" Command="{Binding RefreshDevicesCommand}"
                                        Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                            </StackPanel>
                            <TextBlock Text="音量（即时）" Style="{StaticResource FieldLabel}" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Caption}" Margin="2,0,6,14"
                               Text="外放模式每段朗读开头会用约 0.3 s 学习回声路径，再开放打断判定；戴耳机时切换「耳机模式」可获得最快、最准的打断。" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,9">
            <DockPanel LastChildFill="False">
                <TextBlock Text="判定窗口越短打断越快；外放时回声门控会自动学习扬声器泄漏。" FontSize="11.5"
                           Foreground="{StaticResource Sub}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatsText}" FontSize="11.5"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- 气泡提示 -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}" Panel.ZIndex="20" IsHitTestVisible="False"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,28,0" MaxWidth="380">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding Background}" CornerRadius="9" Padding="14,10" Margin="0,0,0,8" MinWidth="220">
                        <TextBlock Text="{Binding Text}" Foreground="#FFFFFF" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
