<Window x:Class="LiveInterp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LiveInterp.ViewModels"
        Title="同传机器人 · 离线"
        Width="1040" Height="800" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Page}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <DataTemplate x:Key="SystemTemplate">
            <Border HorizontalAlignment="Center" Background="#EEF2F7" CornerRadius="10"
                    Padding="14,7" Margin="0,5" MaxWidth="760">
                <TextBlock Text="{Binding Text}" FontSize="11.5" Foreground="#64748B"
                           TextWrapping="Wrap" TextAlignment="Left" LineHeight="18" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ExchangeTemplate">
            <StackPanel Margin="0,12,0,4">
                <!-- 对方 / 输入 -->
                <StackPanel HorizontalAlignment="Right" MaxWidth="640">
                    <TextBlock Text="{Binding UserLabel}" FontSize="10.5" Foreground="#94A3B8"
                               HorizontalAlignment="Right" Margin="0,0,6,4" />
                    <Border Background="#DCF7F2" CornerRadius="14,14,4,14" Padding="14,10">
                        <TextBlock Text="{Binding Source}" FontSize="14" Foreground="#134E4A"
                                   TextWrapping="Wrap" LineHeight="21" />
                    </Border>
                    <TextBlock Text="{Binding TimeText}" FontSize="9.5" Foreground="#B0BAC8"
                               HorizontalAlignment="Right" Margin="0,4,6,0" />
                </StackPanel>

                <!-- 机器人译文 -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15" Background="#0D9488" VerticalAlignment="Top">
                        <TextBlock Text="译" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" MaxWidth="660" HorizontalAlignment="Left">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="译文" FontSize="10.5" Foreground="#94A3B8" />
                            <Border Background="{Binding StateBack}" CornerRadius="7" Padding="6,1" Margin="8,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StateText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StateText}" Foreground="{Binding StateForeground}" FontSize="9.5" />
                            </Border>
                            <TextBlock Text="{Binding EngineNote}" FontSize="10" Foreground="#94A3B8"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TimingText}" DockPanel.Dock="Right" FontSize="9.5"
                                       Foreground="#B0BAC8" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Background="#FFFFFF" BorderBrush="#E6EBF3" BorderThickness="1"
                                CornerRadius="4,14,14,14" Padding="14,10" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Translation}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{Binding TranslationForeground}" TextWrapping="Wrap"
                                       LineHeight="25" ToolTip="{Binding MatchedSource}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="ChatTemplateSelector" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource ExchangeTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource SystemTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="#0B1626" Padding="22,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="11" Background="#0D9488">
                        <TextBlock Text="译" Foreground="#FFFFFF" FontSize="19" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="同传机器人" Foreground="#FFFFFF" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SubtitleMeta}" Foreground="#7C93B0" FontSize="10.5" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#12233A" CornerRadius="15" Padding="14,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding StateColor}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StateText}" Foreground="#DCE7F5" FontSize="12" Margin="8,0,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding SimulationTestButtonText}" Command="{Binding SimulationTestCommand}"
                            Style="{StaticResource GhostButton}" Width="88" Margin="0,0,8,0" />
                    <Button Content="暂停" Command="{Binding StopCommand}" Style="{StaticResource GhostButton}"
                            Width="70" Margin="0,0,8,0"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <Button Content="继续" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"
                            Width="70" Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 聊天 -->
        <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="24,10">
            <ItemsControl ItemsSource="{Binding ChatMessages}" MaxWidth="960" HorizontalAlignment="Center">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" Style="{StaticResource ChatTemplateSelector}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 输入 -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,12">
            <Grid MaxWidth="960" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CommandBox" Height="40" FontSize="13" VerticalContentAlignment="Center"
                             Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Field}" Margin="0,0,8,0"
                             ToolTip="输入命令，或直接输入要离线翻译的文字">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="发送" Command="{Binding SendCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="24,9" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="麦克风" FontSize="10.5" Foreground="{StaticResource Sub}" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Width="130" Margin="8,0,0,0"
                                 Style="{StaticResource LevelBar}" Value="{Binding MicLevel, Mode=OneWay}" />
                    <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="10.5"
                               Foreground="{StaticResource Sub}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding StatsText}" FontSize="10.5"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Grid.Row="2" Text="直接说话即自动识别中/英并翻译；输入 /help 查看命令，输入文字可直接离线翻译。"
                           Style="{StaticResource Caption}" Margin="0,6,0,0" />
            </Grid>
        </Border>

        <!-- 底栏 -->
        <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,7">
            <StackPanel MaxWidth="960" HorizontalAlignment="Center">
                <TextBlock Text="{Binding OfflineInfo}" Style="{StaticResource Caption}" Foreground="#334155" />
                <TextBlock Text="{Binding OfflineSources}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- 气泡提示 -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}" Panel.ZIndex="20" IsHitTestVisible="False"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,28,0" MaxWidth="380">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding Background}" CornerRadius="9" Padding="14,10" Margin="0,0,0,8" MinWidth="220">
                        <TextBlock Text="{Binding Text}" Foreground="#FFFFFF" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
